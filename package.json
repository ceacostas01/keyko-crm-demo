{
  "name": "keyko-crm",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm --filter @keyko/web build",
    "test:migrations": "./scripts/check-migrations.sh",
    "db:status": "pnpm --filter @keyko/db migrate:status",
    "db:migrate": "pnpm --filter @keyko/db migrate",
    "db:baseline": "pnpm --filter @keyko/db migrate:baseline",
    "dev:api": "pnpm --filter @keyko/api demo",
    "dev:web": "pnpm --filter @keyko/web dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
