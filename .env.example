# Variables de entorno — SOLO nombres, nunca valores reales.
# Copiar a .dev.vars (ignorado por git) y llenar en local.
# En producción: wrangler secret put <NOMBRE>

# --- Turso ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=

# --- Kapso / WhatsApp ---
KAPSO_API_KEY=
KAPSO_API_BASE_URL=
KAPSO_WEBHOOK_SECRET=

# --- IA del CRM (OpenRouter) ---
# Clave independiente: nunca la de OpenCode.
AI_API_KEY=
AI_PROVIDER=fake
AI_MODEL=openai/gpt-4o-mini
# Apagada por defecto; se enciende explícitamente en la prueba aislada.
AI_ENABLED=false
AI_AUTO_APPLY=false
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_ATTEMPTS=3
AI_DAILY_BUDGET_USD_MICROS=100000
AI_MONTHLY_BUDGET_USD_MICROS=5000000
AI_STORE_RAW_RESPONSE=false
AI_RAW_RETENTION_DAYS=7
AI_SUGGESTION_RETENTION_DAYS=180
AI_USAGE_RETENTION_DAYS=180

# --- Fotografías (R2) ---
# El binding se configura en wrangler.toml; aquí solo los límites.
PHOTO_MAX_BYTES=5242880
PHOTO_URL_TTL_SECONDS=900

# --- Auth del CRM ---
JWT_SECRET=

# Base pública de la API cuando el frontend vive en otro dominio.
# Vacía en desarrollo (Vite hace proxy de /api).
VITE_API_BASE_URL=

# Orígenes permitidos por CORS, separados por coma.
# Producción: la URL exacta del frontend. Sin comodines.
ALLOWED_ORIGINS=http://localhost:5173
